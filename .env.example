# FERREMAX — Variables de entorno de ejemplo
# Copiar este archivo a backend/.env y ajustar los valores.
# El archivo .env real NO debe subirse a Git.

# Clave secreta de Django — cambiar en producción por un valor aleatorio seguro
DJANGO_SECRET_KEY=change-me-local-dev

# Modo debug — True en local, False en producción
DEBUG=True

# Hosts permitidos — separados por coma
# En producción: tu-dominio.pythonanywhere.com o tu-dominio.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Orígenes de confianza para CSRF — requerido en producción con HTTPS
# Ejemplo: https://usuario.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=

# Ruta personalizada de SQLite — dejar vacío para usar backend/db.sqlite3 por defecto
# En PythonAnywhere: /home/<usuario>/data/ferremax.sqlite3
SQLITE_PATH=

# Webpay Plus — credenciales públicas de integration/testing (NO usar en producción real)
TRANSBANK_ENVIRONMENT=integration
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
